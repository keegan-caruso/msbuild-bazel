load("@rules_msbuild//msbuild:defs.bzl", "msbuild_binary", "msbuild_test")

msbuild_binary(
    name = "App",
    srcs = ["Program.cs"],
    project = "App.csproj",
    target_framework = "net10.0",
    deps = ["//Library"],
)

