<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NuGet.Versioning" HintPath="$(MSBuildBinPath)/NuGet.Versioning.dll" Private="true" />
    <Reference Include="Microsoft.Build" HintPath="$(MSBuildBinPath)/Microsoft.Build.dll" Private="true" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" Private="true" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../PilotPackagePolicy.cs" Link="PilotPackagePolicy.cs" />
    <EmbeddedResource Include="../pilot-package-policy.json" LogicalName="pilot-package-policy.json" />
  </ItemGroup>
  <ItemGroup><Compile Include="../NerdbankProject.cs" Link="NerdbankProject.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../FrameworkPack.cs" Link="FrameworkPack.cs" /></ItemGroup>
</Project>
