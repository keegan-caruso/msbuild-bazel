<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../MSBuildTool.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">$(DefineConstants);STABLE_PROJECT_CACHE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AnalyzerConfigs.cs" />
    <Compile Include="../PackageSdks.cs" />
    <Compile Include="../NuGetLocks.cs" />
    <Compile Include="../GraphEntryProperties.cs" />
    <Compile Include="../GraphSolutions.cs" />
    <Compile Include="../GraphCompilerReferences.cs" />
    <Compile Include="../GraphProjectKind.cs" />
    <Compile Include="../GraphSourcePattern.cs" />
    <Compile Include="../ProjectCache/SnapshotPayloads.cs" />
    <Compile Include="../ProjectCache/CachedTargetItem.cs" />
    <Compile Include="../ProjectCache/RemoteSnapshotStore.cs" />
    <Reference Include="Microsoft.Build" HintPath="$(RulesMSBuildEngineRoot)/Microsoft.Build.dll" Private="true" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(RulesMSBuildEngineRoot)/Microsoft.Build.Framework.dll" Private="true" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(RulesMSBuildEngineRoot)/Microsoft.Build.Utilities.Core.dll" Private="true" />
  </ItemGroup>
</Project>
