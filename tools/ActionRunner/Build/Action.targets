<Project>
  <Import Project="$(RULES_MSBUILD_REPLAY_WORKSPACE)/Directory.Build.targets" />
  <PropertyGroup Condition="'$(RULES_MSBUILD_GRAPH_SELECTION_TARGETS)' != ''">
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(RULES_MSBUILD_GRAPH_SELECTION_TARGETS)</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCachePlugin Include="$(RULES_MSBUILD_REPLAY_PLUGIN)" />
  </ItemGroup>
  <Target Name="BazelUseInActionCompiler" BeforeTargets="CoreCompile"><PropertyGroup><UseSharedCompilation>false</UseSharedCompilation></PropertyGroup></Target>
</Project>
