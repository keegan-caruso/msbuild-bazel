<Project>
  <!-- These inputs describe the adapter tools, not the projects they build. -->
  <PropertyGroup>
    <RulesMSBuildToolTargetFramework Condition="'$(RulesMSBuildToolTargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</RulesMSBuildToolTargetFramework>
    <RulesMSBuildEngineRoot Condition="'$(RulesMSBuildEngineRoot)' == ''">$(MSBuildBinPath)</RulesMSBuildEngineRoot>
    <LangVersion>latest</LangVersion>
    <TargetFramework>$(RulesMSBuildToolTargetFramework)</TargetFramework>
  </PropertyGroup>
  <Target Name="ValidateMSBuildToolInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BundledNETCoreAppTargetFrameworkVersion)' == ''"
           Text="The selected SDK must report BundledNETCoreAppTargetFrameworkVersion for adapter compilation." />
    <Error Condition="'$(TargetFramework)' != '$(RulesMSBuildToolTargetFramework)'"
           Text="TargetFramework must match the explicit RulesMSBuildToolTargetFramework input." />
    <Error Condition="!Exists('$(RulesMSBuildEngineRoot)/Microsoft.Build.dll') or !Exists('$(RulesMSBuildEngineRoot)/Microsoft.Build.Framework.dll') or !Exists('$(RulesMSBuildEngineRoot)/Microsoft.Build.Utilities.Core.dll')"
           Text="RulesMSBuildEngineRoot=$(RulesMSBuildEngineRoot) must contain the selected MSBuild engine assemblies." />
  </Target>
</Project>
