load("//msbuild:toolchain.bzl", "msbuild_toolchain")
load("//msbuild/private:sdk_bootstrap.bzl", "sdk_runtime", "sdk_runtime_toolchain")
load(":assemblies.bzl", "assembly_tests")
load(":facades.bzl", "facade_tests")
load(":inputs.bzl", "input_tests")
load(":layouts.bzl", "layout_tests")
load(":selection.bzl", "selection_tests")
load(":validation.bzl", "validation_tests")

# Deliberately unusable at execution: analysis tests must not compile .NET.
msbuild_toolchain(
    name = "fake_sdk",
    dotnet = "dotnet",
    runner = "Runner.dll",
    sdk = ":sdk_files",
    tags = ["manual"],
)

filegroup(
    name = "sdk_files",
    srcs = [
        "dotnet",
        "host/fxr/mock",
        "sdk.txt",
        "shared/Microsoft.AspNetCore.App/mock",
        "shared/Microsoft.NETCore.App/mock",
    ],
    tags = ["manual"],
)

toolchain(
    name = "toolchain",
    tags = ["manual"],
    toolchain = ":fake_sdk",
    toolchain_type = "//msbuild:toolchain_type",
)

assembly_tests(name = "assemblies")

input_tests(name = "inputs")

validation_tests(name = "validation")

layout_tests(name = "layouts")

facade_tests(name = "facades")

selection_tests(name = "selection")

sdk_runtime(
    name = "fake_runtime",
    dotnet = "dotnet",
    files = ":sdk_files",
    runtime_identifier = "linux-arm64",
    runtime_only = True,
    tags = ["manual"],
    version = "10.0.11",
)

sdk_runtime_toolchain(
    name = "fake_runtime_toolchain",
    runtime = ":fake_runtime",
    tags = ["manual"],
)

toolchain(
    name = "runtime_toolchain",
    tags = ["manual"],
    toolchain = ":fake_runtime_toolchain",
    toolchain_type = "//msbuild:runtime_toolchain_type",
)
