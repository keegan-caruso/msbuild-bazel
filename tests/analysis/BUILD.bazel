load("//msbuild:toolchain.bzl", "msbuild_toolchain")

# Exercise SDK runtime assembly without executing the fake SDK.
# buildifier: disable=bzl-visibility
load("//msbuild/private:sdk_bootstrap.bzl", "sdk_runtime", "sdk_runtime_toolchain")
load(":graph.bzl", "graph_tests")

# Deliberately unusable at execution: analysis tests must not compile .NET.
msbuild_toolchain(
    name = "fake_sdk",
    dotnet = "dotnet",
    runner = "Runner.dll",
    sdk = ":sdk_files",
    tags = ["manual"],
)

filegroup(
    name = "sdk_files",
    srcs = [
        "dotnet",
        "host/fxr/mock",
        "sdk.txt",
        "shared/Microsoft.AspNetCore.App/mock",
        "shared/Microsoft.NETCore.App/mock",
    ],
    tags = ["manual"],
)

toolchain(
    name = "toolchain",
    tags = ["manual"],
    toolchain = ":fake_sdk",
    toolchain_type = "//msbuild:toolchain_type",
)

sdk_runtime(
    name = "fake_runtime",
    dotnet = "dotnet",
    files = ":sdk_files",
    runtime_identifier = "linux-arm64",
    runtime_only = True,
    tags = ["manual"],
    version = "10.0.11",
)

sdk_runtime_toolchain(
    name = "fake_runtime_toolchain",
    runtime = ":fake_runtime",
    tags = ["manual"],
)

toolchain(
    name = "runtime_toolchain",
    tags = ["manual"],
    toolchain = ":fake_runtime_toolchain",
    toolchain_type = "//msbuild:runtime_toolchain_type",
)

graph_tests(name = "graph")

filegroup(
    name = "runner_payload",
    srcs = ["Runner.dll"],
    tags = ["manual"],
)
