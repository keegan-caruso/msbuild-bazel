#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$root/usr/lib/x86_64-linux-gnu:$root/usr/lib/llvm-18/lib"
"$root/usr/bin/clang-18" --version >&2
"$root/usr/bin/ld.lld-18" --version >&2
exec "$root/usr/bin/clang-18" --sysroot="$root" --gcc-toolchain="$root/usr" -fuse-ld=lld -B"$root/usr/bin" -B"$root/usr/lib/llvm-18/bin" -L"$root/usr/lib/x86_64-linux-gnu" "$@"
