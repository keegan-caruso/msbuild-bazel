[
    integration_case(
        name = name + "_cases",
        env = {"RESOLVE_REFERENCES": "1"},
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:aarch64",
        ],
        test_runner = runner,
        workspace_files = glob(["fixtures/" + fixture + "/**"]),
        workspace_path = "tests/integration/fixtures/" + fixture,
    )
    for name, runner, fixture in [
        ("resolved_inputs", ":resolved_inputs_runner", "worker"),
        ("restore_inputs", ":restore_inputs_runner", "worker"),
        ("preparation", ":preparation_runner", "worker"),
        ("cached_sync", ":cached_sync_runner", "worker"),
        ("resolved_package_copies", ":package_copies_runner", "worker"),
        ("resolved_il_sdk", ":il_sdk_runner", "il_sdk"),
    ]
]

[
    integration_suite(
        name = name,
        cases = [name + "_cases"],
    )
    for name in [
        "resolved_inputs",
        "restore_inputs",
        "preparation",
        "cached_sync",
        "resolved_package_copies",
        "resolved_il_sdk",
    ]
]

