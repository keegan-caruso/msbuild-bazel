module(name = "il_sdk_integration")

bazel_dep(name = "rules_msbuild", version = "0.0.0")
local_path_override(
    module_name = "rules_msbuild",
    path = "../msbuild-bazel",
)

dotnet = use_extension("@rules_msbuild//msbuild:extensions.bzl", "dotnet")
dotnet.sdk(
    name = "dotnet",
    global_json = "//:global.json",
)
use_repo(dotnet, "dotnet")

register_toolchains("@dotnet//:all")

nuget = use_extension("@rules_msbuild//msbuild:nuget.bzl", "nuget")
nuget.lock(
    name = "packages",
    lockfile = "//:nuget.lock.json",
)
use_repo(nuget, "packages")
