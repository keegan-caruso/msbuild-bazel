@using Microsoft.AspNetCore.Components.Web
<h1 id="revision">wasm-v1</h1>
<p id="architecture">@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</p>
<button id="increment" @onclick="Increment">Increment managed counter</button>
<p id="count">Managed count: @count</p>
@code {
    private int count;
    private void Increment() => count++;
}
