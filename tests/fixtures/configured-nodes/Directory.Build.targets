<Project>
  <Target Name="ConfiguredCompileEvidence" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="R03_COMPILE:$(MSBuildProjectName)|$(Flavor)|$(TargetFramework)"/>
  </Target>
  <Target Name="ConfiguredOuterEvidence" BeforeTargets="Build" Condition="'$(IsCrossTargetingBuild)' == 'true'">
    <Message Importance="high" Text="R03_OUTER:$(MSBuildProjectName)|$(TargetFrameworks)"/>
  </Target>
</Project>
