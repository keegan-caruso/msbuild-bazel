<Project>
  <PropertyGroup><SpikePackageData>$(MSBuildThisFileDirectory)../data/value.txt</SpikePackageData></PropertyGroup>
  <Target Name="SpikePackageGenerate" BeforeTargets="CoreCompile">
    <Message Text="SPIKE_PACKAGE_TARGET:$(MSBuildProjectName)" Importance="high" />
    <ReadLinesFromFile File="$(SpikePackageData)"><Output TaskParameter="Lines" PropertyName="_PackageValue" /></ReadLinesFromFile>
    <WriteLinesToFile File="$(IntermediateOutputPath)PackageInput.g.cs"
      Lines="namespace Shared { public static class PackageInput { public const string Value = &quot;$(_PackageValue)/target-v1&quot;%3B } }" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)PackageInput.g.cs" /></ItemGroup>
  </Target>
</Project>
